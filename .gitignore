# ==============================================================================
# Paula Personalizados 3D — .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependências e Gerenciadores de Pacotes
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/
.pnp/
.pnp.js

# ------------------------------------------------------------------------------
# 2. Arquivos de Ambiente, Segredos e Credenciais Sensíveis
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Chaves privadas, certificados, tokens e credenciais
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
id_rsa*
id_ed25519*
secrets.json
secrets.yaml
secrets.yml
credentials.json
credentials.yaml
credentials.yml

# ------------------------------------------------------------------------------
# 3. Builds, Compilação e Artefatos de Saída
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo
.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. Logs, Diagnósticos e Relatórios
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 5. Testes e Relatórios de Cobertura
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
.vitest/
test-results/
playwright-report/
blob-report/

# ------------------------------------------------------------------------------
# 6. Configurações de IDEs e Editores
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains (WebStorm, IntelliJ IDEA)
.idea/
*.iws
*.iml

# Visual Studio / Windows
*.suo
*.ntvs*
*.njsproj
*.sln
*.user
*.userosscache
*.sln.docstates

# Vim / Sublime / Outros
*.sw?
*.swo
*.swn
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 7. Arquivos do Sistema Operacional
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# 8. Arquivos e Diretórios de Agentes, IA e Documentações Internas
# ------------------------------------------------------------------------------
AGENTS.md
GEMINI.md
CLAUDE.md
COPILOT.md
CURSOR.md
.agents/
.ai-loop/
.superpowers/
docs/superpowers/
.system_generated/
.gemini/
.cursor/
.windsurf/
scratch/
*.prompt.md
*.scratchpad.md

# ------------------------------------------------------------------------------
# 9. Caches e Temporários
# ------------------------------------------------------------------------------
.cache/
tmp/
temp/
.temp/
.tmp/
.turbo/
